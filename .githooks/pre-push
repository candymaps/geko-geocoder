#!/bin/sh
# Runs before a push (AGENTS.md, «Environment») the checks of ci/test.sh that what it pushes can
# fail (ci/affected.sh): the deterministic ones that the CI ran on every push, now that it is off.
# They test the working tree, so it must be clean: what is pushed is then what was tested. From
# Git for Windows they run inside WSL, where geko builds. GEKO_TEST_ALL=1 runs all of them, as
# `make test`; `git push --no-verify` skips them. Enabled with `git config core.hooksPath .githooks`.

zero=0000000000000000000000000000000000000000
pushed=0 base=
while read -r local_ref local_sha remote_ref remote_sha; do
    [ "$local_sha" = "$zero" ] && continue
    [ -n "$(git rev-list "$local_sha" --not --remotes)" ] || continue
    pushed=$((pushed + 1))
    # A new branch, or a remote commit this clone does not have: what it adds to dev.
    if [ "$remote_sha" = "$zero" ] || ! git cat-file -e "$remote_sha^{commit}" 2> /dev/null; then
        remote_sha=$(git merge-base "$local_sha" origin/dev 2> /dev/null || git merge-base "$local_sha" origin/main)
    fi
    base="$remote_sha $local_sha"
done
[ "$pushed" -gt 0 ] || exit 0

if [ -n "$(git status --porcelain)" ]; then
    echo "pre-push: uncommitted changes; the checks would not test what is pushed. Commit or stash them, or git push --no-verify" >&2
    exit 1
fi

root=$(git rev-parse --show-toplevel)
# Several branches at once: all of them, rather than guess what each one needs.
if [ "${GEKO_TEST_ALL:-0}" != 0 ] || [ "$pushed" -gt 1 ]; then
    args=
else
    # shellcheck disable=SC2086
    args=$(bash "$root/ci/affected.sh" $base) || exit 1
    if [ -z "$args" ]; then
        echo "pre-push: only documentation changed; nothing to check" >&2
        exit 0
    fi
fi
echo "pre-push: ci/test.sh ${args:-(all)} (GEKO_TEST_ALL=1 runs all; git push --no-verify skips it)" >&2
if [ -n "${WSL_DISTRO_NAME:-}" ] || [ "$(uname -s)" = Linux ]; then
    # shellcheck disable=SC2086
    (cd "$root" && ci/test.sh $args)
else
    # Without /dev/null, wsl.exe would read the refs that git writes to the hook.
    dir=$(wsl.exe wslpath -a "$root" < /dev/null | tr -d '\r')
    # Rust and its target directory as AGENTS.md sets them (outside /mnt, to build fast).
    wsl.exe -- bash -lc ". \"\$HOME/.cargo/env\" 2> /dev/null; export CARGO_TARGET_DIR=\"\${CARGO_TARGET_DIR:-\$HOME/.cache/geko-target}\"; cd '$dir' && ci/test.sh $args" < /dev/null
fi
status=$?
[ "$status" = 0 ] || echo "pre-push: the checks failed; nothing was pushed" >&2
exit $status
